# Local development; copy to backend/.env and change SESSION_SECRET.
DATABASE_URL=sqlite:///./finwise_dev.db
SESSION_SECRET=replace-with-a-long-random-development-secret
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8000

# Production on Render: set these in the Dashboard, not in this file.
# DATABASE_URL=postgresql+psycopg2://...-pooler.../finwise?sslmode=require
# MIGRATION_DATABASE_URL=postgresql+psycopg2://.../finwise?sslmode=require
